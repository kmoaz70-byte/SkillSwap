        <nav class="navbar navbar-expand-sm navbar-toggleable-sm sticky-top" id="mainNav">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
