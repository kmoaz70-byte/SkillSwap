@model BrowseIndexViewModel
@using Models.Enums
<div class="container mt-4 fade-in">

<h2 class="mb-4">Browse Skills</h2>

<form asp-controller="Browse" asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Search skill name..." />
    </div>
    <div class="col-md-3">
        <select name="Category" class="form-select">
            <option value="">All Categories</option>
            @foreach (var item in Html.GetEnumSelectList<SkillCategory>())
            {
                <option value="@item.Value" selected="@(Model.Filter.Category?.ToString() == item.Value)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="Type" class="form-select">
            <option value="">Offering or Seeking</option>
            @foreach (var item in Html.GetEnumSelectList<SkillType>())
            {
                <option value="@item.Value" selected="@(Model.Filter.Type?.ToString() == item.Value)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="Proficiency" class="form-select">
            <option value="">Any Level</option>
            @foreach (var item in Html.GetEnumSelectList<ProficiencyLevel>())
            {
                <option value="@item.Value" selected="@(Model.Filter.Proficiency?.ToString() == item.Value)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>

<p class="text-muted">@Model.TotalCount result(s) found</p>

<div class="row">
    @if (!Model.Results.Any())
    {
        <p>No skills match your search.</p>
    }
    @foreach (var result in Model.Results)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@result.SkillName</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@result.Category - @result.Type</h6>
                    <p class="card-text">Level: @result.Proficiency</p>
                    @if (!string.IsNullOrEmpty(result.AdditionalInfo))
                    {
                        <p class="card-text">@result.AdditionalInfo</p>
                    }
                    <hr />
                    <p class="mb-1"><strong>@result.UserFullName</strong></p>
                    @if (!string.IsNullOrEmpty(result.UserLocation))
                    {
                        <p class="text-muted small">@result.UserLocation</p>
                    }
                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@result.UserId" class="btn btn-outline-primary btn-sm">View Profile</a>
                    <a asp-controller="Swap" asp-action="Request" asp-route-receiverId="@result.UserId" asp-route-receiverSkillId="@result.UserSkillId" class="btn btn-success btn-sm">Request Swap</a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Page="@i"
                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                       asp-route-Category="@Model.Filter.Category"
                       asp-route-Type="@Model.Filter.Type"
                       asp-route-Proficiency="@Model.Filter.Proficiency">@i</a>
                </li>
            }
        </ul>
    </nav>
}
</div>