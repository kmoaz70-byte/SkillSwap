@using Models.Models
@model List<Message>
<div class="container mt-4 fade-in">
<h3 class="mb-3" >Chat with @ViewBag.OtherUserName</h3>

<div class="chat-container">
    <div class="chat-messages" id="chatBox">
        @foreach (var msg in Model)
        {
            var isSent = msg.SenderId == (string)ViewBag.CurrentUserId;
            <div class="chat-message @(isSent ? "sent" : "received")">
                <div class="chat-bubble">@msg.Content</div>
                <div class="chat-timestamp">@msg.SentAt.ToLocalTime().ToString("g")</div>
            </div>
        }
    </div>
    <div class="chat-input-area">
        <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
        <button id="sendButton" class="btn btn-primary">➤</button>
    </div>
</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
<script>
    const otherUserId = "@ViewBag.OtherUserId";
    const chatBox = document.getElementById("chatBox");
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();

    connection.on("ReceiveMessage", function (senderId, content) {
        const isSent = senderId !== otherUserId;
        const wrapper = document.createElement("div");
        wrapper.className = "chat-message " + (isSent ? "sent" : "received");

        const bubble = document.createElement("div");
        bubble.className = "chat-bubble";
        bubble.textContent = content;

        const time = document.createElement("div");
        time.className = "chat-timestamp";
        time.textContent = new Date().toLocaleString();

        wrapper.appendChild(bubble);
        wrapper.appendChild(time);
        chatBox.appendChild(wrapper);
        chatBox.scrollTop = chatBox.scrollHeight;
    });

    connection.start().catch(err => console.error(err.toString()));

    document.getElementById("sendButton").addEventListener("click", function () {
        const input = document.getElementById("messageInput");
        const content = input.value.trim();
        if (content === "") return;
        connection.invoke("SendMessage", otherUserId, content).catch(err => console.error(err.toString()));
        fetch("/Message/SaveMessage", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: "receiverId=" + encodeURIComponent(otherUserId) + "&content=" + encodeURIComponent(content)
        });
        input.value = "";
    });
</script>