@using Models.Enums
@using Models.ViewModels
@model IEnumerable<SwapRequestDisplayViewModel>
<div class="container mt-4 fade-in">
<h2>Sent Requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>To</th>
            <th>Your Skill</th>
            <th>Their Skill</th>
            <th>Status</th>
            <th>Sent On</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.OtherUserName</td>
                <td>@r.MySkillName</td>
                <td>@r.TheirSkillName</td>
                <td>@r.Status</td>
                <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                <td>
                    @if (r.Status == SwapStatus.Pending)
                    {
                        <form asp-controller="Swap" asp-action="Cancel" asp-route-id="@r.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-reject">Cancel</button>
                        </form>
                    }
                    @if (r.Status == SwapStatus.Accepted)
                    {
                        <form asp-controller="Swap" asp-action="MarkComplete" asp-route-id="@r.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-complete">Mark as Completed</button>
                        </form>
                    }

                    @if (r.Status == SwapStatus.Completed)
                    {
                        <a asp-controller="Rating" asp-action="Rate" asp-route-swapRequestId="@r.Id" class="btn btn-sm btn-view">Rate</a>
                    }
                    <a asp-controller="Message" asp-action="Chat" asp-route-otherUserId="@r.OtherUserId" class="btn btn-sm btn-message">
                        Message
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>