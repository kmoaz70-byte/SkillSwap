@using Models
@using Models.Models
@{
    ViewData["Title"] = "My Skills";
    var offered = ViewBag.OfferedSkills as IEnumerable<UserSkill>;
    var wanted = ViewBag.WantedSkills as IEnumerable<UserSkill>;
}
<div class="container mt-4 fade-in">
<h2>My Skills</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a asp-action="Add" class="btn btn-primary">Add Skill</a>
    <a asp-action="SuggestSkill" class="btn btn-sm btn-message">Suggest New Skill</a>
</div>

<h4>Skills I'm Offering</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Skill</th>
            <th>Proficiency</th>
            <th>Additional Info</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (offered != null && offered.Any())
        {
            @foreach (var item in offered)
            {
                <tr>
                    <td>@item.Skill.Name</td>
                    <td>@item.ProficiencyLevel</td>
                    <td>@item.AdditionalInfo</td>
                    <td>
                        <form asp-action="Remove" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Remove this skill?');">
                                Remove
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4">No skills offered yet.</td></tr>
        }
    </tbody>
</table>

<h4>Skills I'm Seeking</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Skill</th>
            <th>Proficiency</th>
            <th>Additional Info</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (wanted != null && wanted.Any())
        {
            @foreach (var item in wanted)
            {
                <tr>
                    <td>@item.Skill.Name</td>
                    <td>@item.ProficiencyLevel</td>
                    <td>@item.AdditionalInfo</td>
                    <td>
                        <form asp-action="Remove" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Remove this skill?');">
                                Remove
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4">No skills sought yet.</td></tr>
        }
    </tbody>
</table>
</div>