                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-gradient btn-sm" asp-controller="Account" asp-action="Register">Get Started</a>
                            </li>
                        }
