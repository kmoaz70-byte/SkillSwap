@using Models.Models
@model List<ApplicationUser>
<div class="container mt-4 fade-in">
<h2 class="mb-4">Manage Users</h2>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    @if (user.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
                <td>
                    @if (user.IsActive)
                    {
                        <a asp-controller="Admin" asp-action="DeactivateUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Deactivate</a>
                    }
                    else
                    {
                        <a asp-controller="Admin" asp-action="ActivateUser" asp-route-id="@user.Id" class="btn btn-sm btn-success">Activate</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>